table CompanyData
	lineageTag: 702cac45-d430-43e4-a841-2fb5ad6c0d38

	measure 'Total Market Cap' = CALCULATE(AVERAGE(CompanyData[Market_Cap_B]), CompanyData[Record_Type] = "Actual")
		formatString: #,0.0
		lineageTag: 662243ff-1ca3-4641-a691-5c46a52da740

	measure 'Projected AI Growth' = AVERAGEX(VALUES(CompanyData[Company]), DIVIDE(CALCULATE(LASTNONBLANKVALUE(CompanyData[Date], AVERAGE(CompanyData[Normalized_Index])), CompanyData[Record_Type] = "AI Forecast (3Y)") - CALCULATE(LASTNONBLANKVALUE(CompanyData[Date], AVERAGE(CompanyData[Normalized_Index])), CompanyData[Record_Type] = "Actual"), CALCULATE(LASTNONBLANKVALUE(CompanyData[Date], AVERAGE(CompanyData[Normalized_Index])), CompanyData[Record_Type] = "Actual"), 0))
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 599d662e-bc89-4086-bfd0-f457a86114a2

	measure 'Historical Return' = AVERAGEX(VALUES(CompanyData[Company]), DIVIDE(CALCULATE(LASTNONBLANKVALUE(CompanyData[Date], AVERAGE(CompanyData[Normalized_Index])), CompanyData[Record_Type] = "Actual") - CALCULATE(FIRSTNONBLANKVALUE(CompanyData[Date], AVERAGE(CompanyData[Normalized_Index])), CompanyData[Record_Type] = "Actual"), CALCULATE(FIRSTNONBLANKVALUE(CompanyData[Date], AVERAGE(CompanyData[Normalized_Index])), CompanyData[Record_Type] = "Actual"), 0))
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 3e77dd56-b7db-47f7-b887-d3347aa53a18

	measure 'Operating Margin' = AVERAGE(CompanyData[Operating_Margin_Pct]) / 100
		formatString: 0.0%
		lineageTag: eb0b6b5e-b355-4f5e-b96e-cbf0a768ea50

	measure 'NLP Sentiment' = AVERAGE(CompanyData[NLP_Sentiment_Score])
		formatString: 0.0
		lineageTag: 5151f88d-31f8-4161-b968-12ad92167b39

	measure 'Performance Index' = AVERAGE(CompanyData[Normalized_Index])
		formatString: #,0.0
		lineageTag: 1699710f-ca29-450d-babb-212b88b2a05e

	measure 'Forecast Upper' = AVERAGE(CompanyData[Forecast_Upper_Index])
		formatString: #,0.0
		lineageTag: 44f43ec2-0f9a-417b-ab23-ccf3d4dfc454

	measure 'Forecast Lower' = AVERAGE(CompanyData[Forecast_Lower_Index])
		formatString: #,0.0
		lineageTag: 963c0d63-c8bd-47a7-848b-06575e026785

	measure 'Annual Revenue RunRate' = AVERAGE(CompanyData[Monthly_Revenue_B]) * 12
		formatString: #,0.0
		lineageTag: ee9f4a09-7ef1-4b71-b259-b58d18b4fab0

	measure 'Return on Equity' = AVERAGE(CompanyData[ROE_Pct]) / 100
		formatString: 0.0%
		lineageTag: b7413bf9-922c-4f30-9f71-65fc0d515e05

	measure 'Debt to Equity' = AVERAGE(CompanyData[Debt_to_Equity])
		formatString: 0.00
		lineageTag: b66b6de1-bec4-4193-9083-f1e2c54cf480

