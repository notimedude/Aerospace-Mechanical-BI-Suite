	partition CompanyData = m
		mode: import
		source =
				let
				    AeroRaw = Csv.Document(File.Contents("C:\\PBI_Dashboards\\data\\aerospace_data.csv"),[Delimiter=",", Columns=15, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    AeroPromoted = Table.PromoteHeaders(AeroRaw, [PromoteAllScalars=true]),
				    MechRaw = Csv.Document(File.Contents("C:\\PBI_Dashboards\\data\\mechanical_data.csv"),[Delimiter=",", Columns=15, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    MechPromoted = Table.PromoteHeaders(MechRaw, [PromoteAllScalars=true]),
				    Combined = Table.Combine({AeroPromoted, MechPromoted}),
				    Typed = Table.TransformColumnTypes(Combined,{{"Date", type date}, {"Close_Price", type number}, {"Normalized_Index", type number}, {"Monthly_Revenue_B", type number}, {"Operating_Margin_Pct", type number}, {"ROE_Pct", type number}, {"Debt_to_Equity", type number}, {"Market_Cap_B", type number}, {"NLP_Sentiment_Score", type number}, {"Forecast_Lower_Index", type number}, {"Forecast_Upper_Index", type number}})
				in
				    Typed

